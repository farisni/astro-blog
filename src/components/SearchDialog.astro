---
import Icon from "./Icon.astro";
---

<dialog class="lite-search-dialog" data-search-dialog>
  <div class="lite-search-box">
    <header>
      <Icon name="search" size={20} />
      <input data-search-input type="search" placeholder="输入关键词搜索文章…" autocomplete="off" />
      <button type="button" data-search-close aria-label="关闭搜索"><Icon name="close" /></button>
    </header>
    <div class="lite-search-results" data-search-results>
      <p>输入标题、摘要、分类或标签开始搜索。</p>
    </div>
    <footer><span>↑↓ 浏览</span><span>Esc 关闭</span></footer>
  </div>
</dialog>

<script>
  interface SearchItem {
    title: string;
    description: string;
    href: string;
    category: string;
    tags: string[];
  }

  const dialog = document.querySelector<HTMLDialogElement>("[data-search-dialog]");
  const input = dialog?.querySelector<HTMLInputElement>("[data-search-input]");
  const results = dialog?.querySelector<HTMLElement>("[data-search-results]");
  let index: SearchItem[] | null = null;

  const openSearch = async () => {
    if (!dialog) return;
    dialog.showModal();
    input?.focus();
    if (!index) index = await fetch("/search.json").then((response) => response.json());
  };

  const closeSearch = () => dialog?.close();

  document.querySelectorAll("[data-search-open]").forEach((button) => button.addEventListener("click", openSearch));
  dialog?.querySelector("[data-search-close]")?.addEventListener("click", closeSearch);
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) closeSearch();
  });

  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      openSearch();
    }
  });

  input?.addEventListener("input", () => {
    if (!results || !index) return;
    const query = input.value.trim().toLocaleLowerCase();
    results.replaceChildren();
    if (!query) {
      const message = document.createElement("p");
      message.textContent = "输入标题、摘要、分类或标签开始搜索。";
      results.append(message);
      return;
    }
    const matches = index.filter((item) =>
      [item.title, item.description, item.category, ...item.tags]
        .join(" ")
        .toLocaleLowerCase()
        .includes(query),
    ).slice(0, 8);
    if (!matches.length) {
      const message = document.createElement("p");
      message.textContent = "没有找到相关文章。";
      results.append(message);
      return;
    }
    matches.forEach((item) => {
      const link = document.createElement("a");
      link.href = item.href;
      const title = document.createElement("strong");
      title.textContent = item.title;
      const description = document.createElement("span");
      description.textContent = item.description || item.category;
      link.append(title, description);
      results.append(link);
    });
  });
</script>
