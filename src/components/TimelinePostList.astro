---
import type { Language } from '@/i18n/config'
import type { Post } from '@/types'
import { getPostPath } from '@/i18n/path'
import { getPostDescription } from '@/utils/description'

export interface Props {
  posts: Post[]
  lang: Language
  year: number
}

const { posts, lang, year } = Astro.props

function getDateKey(date: Date) {
  return [
    date.getFullYear(),
    String(date.getMonth() + 1).padStart(2, '0'),
    String(date.getDate()).padStart(2, '0'),
  ].join('-')
}

function formatTimelineDate(date: Date) {
  return `${String(date.getMonth() + 1).padStart(2, '0')}.${String(date.getDate()).padStart(2, '0')}`
}
---

<section class="mb-10 last:mb-0">
  <header class="mb-5 flex items-center gap-3">
    <h3 class="shrink-0 text-4.5 c-primary/90 font-navbar font-bold leading-[1.4] tracking-wide">
      {year}
    </h3>
    <span aria-hidden="true" class="h-px min-w-8 flex-1 bg-secondary/20" />
  </header>

  <ul>
    {posts.map((post, index) => {
      const slug = post.data.abbrlink || post.id
      const dateKey = getDateKey(post.data.publishDate)
      const previousDateKey = index > 0
        ? getDateKey(posts[index - 1].data.publishDate)
        : undefined
      const isRepeatedDate = dateKey === previousDateKey

      return (
        <li class="mb-7 grid grid-cols-[2.75rem_minmax(0,1fr)] items-start gap-x-3 last:mb-0 lg:grid-cols-[3.25rem_minmax(0,1fr)] lg:gap-x-4">
          <time
            class:list={[
              'timeline-date h-[1.540625rem] flex items-center text-3.25 c-secondary/70 font-sans font-normal leading-none tracking-normal lg:h-[1.63125rem] lg:text-3.5',
              isRepeatedDate ? 'op-0 select-none' : '',
            ]}
            datetime={dateKey}
          >
            {formatTimelineDate(post.data.publishDate)}
          </time>

          <article class="min-w-0">
            <a
              class="timeline-post-card inline-block max-w-full w-auto"
              href={getPostPath(slug, lang)}
            >
              <h4
                class="min-w-0 text-4.25 c-primary/82 font-medium leading-[1.45] transition-colors cjk:tracking-wide lg:text-4.5"
                transition:name={`post-${slug}${lang ? `-${lang}` : ''}`}
                data-disable-theme-toggle-transition
              >
                {post.data.title}
              </h4>

              <p class="mt-2 text-3.5 c-secondary/90 leading-1.65em cjk:tracking-wide lg:text-3.75">
                {getPostDescription(post, 'list')}
              </p>
            </a>
          </article>
        </li>
      )
    })}
  </ul>
</section>

<style>
  .timeline-post-card {
    position: relative;
    z-index: 0;
    isolation: isolate;
  }

  .timeline-post-card::before {
    position: absolute;
    z-index: -1;
    inset: -0.65rem -0.85rem;
    border-radius: 0.5rem;
    background: oklch(88% 0.04 235 / 0.14);
    content: '';
    opacity: 0;
    transform: scale(0.85);
    transition:
      opacity 150ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .timeline-post-card:hover::before,
  .timeline-post-card:focus-visible::before {
    opacity: 1;
    transform: scale(1);
  }

  :global(html.dark) .timeline-post-card::before {
    background: oklch(78% 0.04 235 / 0.08);
  }
</style>
