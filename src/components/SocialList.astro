---
import { Icon } from "astro-icon/components";

/** 
	Uses https://www.astroicon.dev/getting-started/
	Find icons via guide: https://www.astroicon.dev/guides/customization/#open-source-icon-sets
	Only installed pack is: @iconify-json/mdi
*/
const socialLinks: {
	friendlyName: string;
	label?: string;
	link: string;
	name: string;
	newTab?: boolean;
}[] = [
	{
		friendlyName: "Github",
		link: "https://github.com/farisni",
		name: "mdi:github",
		newTab: true,
	},
	{
		friendlyName: "发送邮件至 faris.ni@outlook.com",
		label: "faris.ni@outlook.com",
		link: "mailto:faris.ni@outlook.com",
		name: "mdi:email",
	},
];
---

<div>
	<ul class="flex items-center gap-x-5">
		{
			socialLinks.map(({ friendlyName, label, link, name, newTab }) => (
				<li class="flex">
					<a
						aria-label={friendlyName}
						class="text-muted hover:text-accent inline-flex items-center gap-2 transition-colors"
						href={link}
						rel={newTab ? "noreferrer noopener" : undefined}
						target={newTab ? "_blank" : undefined}
					>
						<Icon aria-hidden="true" class="h-6 w-6" focusable="false" name={name} />
						{label && <span class="whitespace-nowrap">{label}</span>}
					</a>
				</li>
			))
		}
	</ul>
</div>
