---
import { Icon } from "astro-icon/components";

/** 
	Uses https://www.astroicon.dev/getting-started/
	Find icons via guide: https://www.astroicon.dev/guides/customization/#open-source-icon-sets
	Only installed pack is: @iconify-json/mdi
*/
const socialLinks: {
	friendlyName: string;
	link: string;
	name: string;
	newTab?: boolean;
}[] = [
	{
		friendlyName: "Github",
		link: "https://github.com/farisni",
		name: "mdi:github",
		newTab: true,
	},
	{
		friendlyName: "发送邮件",
		link: "mailto:wenmengshaonian@gmail.com",
		name: "mdi:email",
	},
	{
		friendlyName: "RSS",
		link: "/rss.xml",
		name: "mdi:rss",
	},
];
---

<div>
	<ul class="flex items-center gap-x-5">
		{
			socialLinks.map(({ friendlyName, link, name, newTab }) => (
				<li class="flex">
					<a
						class="text-muted hover:text-accent inline-block transition-colors"
						href={link}
						rel={newTab ? "noreferrer noopener" : undefined}
						target={newTab ? "_blank" : undefined}
					>
						<Icon aria-hidden="true" class="h-6 w-6" focusable="false" name={name} />
						<span class="sr-only">{friendlyName}</span>
					</a>
				</li>
			))
		}
	</ul>
</div>
