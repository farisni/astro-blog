---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  mobile?: boolean;
}

const { headings, mobile = false } = Astro.props;
const items = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 4);
---

{
  items.length > 0 && (
    mobile ? (
      <details class="handsome-mobile-toc">
        <summary>文章目录</summary>
        <ol>
          {items.map((item) => (
            <li style={`--toc-depth: ${item.depth - 2}`}>
              <a href={`#${item.slug}`}>{item.text}</a>
            </li>
          ))}
        </ol>
      </details>
    ) : (
      <nav class="handsome-article-toc" aria-label="文章目录">
        <h2 class="handsome-article-toc-title">文章目录</h2>
        <ol>
          {items.map((item) => (
            <li>
              <button type="button" data-level={item.depth} data-toc-link={item.slug}>
                <span class="handsome-article-toc-marker" aria-hidden="true"></span>
                <span class="handsome-article-toc-label">{item.text}</span>
              </button>
            </li>
          ))}
        </ol>
      </nav>
    )
  )
}

{
  !mobile && (
    <script>
      const tocButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-toc-link]")];
      const headings = tocButtons
        .map((button) => document.getElementById(button.dataset.tocLink ?? ""))
        .filter((heading): heading is HTMLElement => Boolean(heading));

      if (headings.length) {
        let frame = 0;
        const updateActiveHeading = () => {
          const readingLine = window.scrollY + 120;
          let activeId = headings[0].id;

          for (const heading of headings) {
            if (heading.getBoundingClientRect().top + window.scrollY > readingLine) break;
            activeId = heading.id;
          }

          tocButtons.forEach((button) => {
            const active = button.dataset.tocLink === activeId;
            button.classList.toggle("is-active", active);
            if (active) button.setAttribute("aria-current", "location");
            else button.removeAttribute("aria-current");
          });
        };

        tocButtons.forEach((button) => {
          button.addEventListener("click", () => {
            document.getElementById(button.dataset.tocLink ?? "")?.scrollIntoView({
              behavior: "smooth",
              block: "start",
            });
          });
        });

        window.addEventListener("scroll", () => {
          window.cancelAnimationFrame(frame);
          frame = window.requestAnimationFrame(updateActiveHeading);
        }, { passive: true });
        updateActiveHeading();
      }
    </script>
  )
}
