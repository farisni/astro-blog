---
import { siteConfig } from "../config";
import Icon from "./Icon.astro";

interface Category {
  name: string;
  slug: string;
  count: number;
}

interface Props {
  categories: Category[];
  pathname: string;
}

const { categories, pathname } = Astro.props;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" || pathname.startsWith("/page/") : pathname.startsWith(href);
---

<aside class="handsome-sidebar">
  <div class="handsome-sidebar-inner">
    <a class="handsome-identity" href="/about/">
      <img src={siteConfig.author.avatar} width="68" height="68" alt={siteConfig.author.name} />
      <span class="handsome-identity-copy">
        <strong>{siteConfig.author.name}</strong>
        <small>{siteConfig.author.email}</small>
      </span>
    </a>

    <nav class="lite-nav" aria-label="主导航">
      <span class="lite-nav-label">导航</span>
      {
        siteConfig.navigation.map((item) => (
          <a
            class:list={{ active: isActive(item.href) }}
            href={item.href}
            target={item.external ? "_blank" : undefined}
            rel={item.external ? "noreferrer" : undefined}
          >
            <Icon name={item.icon} />
            <span>{item.label}</span>
            {item.external && <Icon name="external" size={14} />}
          </a>
        ))
      }

      <details class="lite-nav-group" open>
        <summary class="lite-nav-group-title">
          <span><Icon name="folder" />文章分类</span>
          <Icon name="chevron" size={15} />
        </summary>
        <div class="lite-category-list">
          {
            categories.map((category) => (
              <a href={`/categories/${category.slug}/`}>
                <span>{category.name}</span>
                <small>{category.count}</small>
              </a>
            ))
          }
        </div>
      </details>
    </nav>

    <div class="handsome-sidebar-footer">
      {
        siteConfig.socials.map((social) => (
          <a href={social.href} aria-label={social.label} title={social.label}>
            <Icon name={social.icon} size={17} />
          </a>
        ))
      }
      <span>© {new Date().getFullYear()}</span>
    </div>
  </div>
</aside>
