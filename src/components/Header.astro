---
import { siteConfig } from "../config";
import Icon from "./Icon.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="handsome-topbar">
  <div class="handsome-topbar-sidebar">
    <a class="lite-brand-symbol" href="/" aria-label={`${siteConfig.title} 首页`}>
      <img src={siteConfig.hero.image} alt="" />
    </a>
  </div>
  <div class="handsome-header">
    <button class="handsome-mobile-menu" type="button" data-mobile-menu aria-label="打开导航">
      <Icon name="menu" />
    </button>
    <button class="handsome-search" type="button" data-search-open aria-label="搜索文章" title="搜索">
      <Icon name="search" size={20} />
    </button>
    <div class="handsome-header-actions">
      <ThemeToggle />
      <a class="handsome-header-link" href="/about/" aria-label="关于作者">
        <Icon name="user" size={20} />
      </a>
    </div>
  </div>
</header>

<script>
  const menuButton = document.querySelector<HTMLElement>("[data-mobile-menu]");
  const closeMenu = () => document.body.classList.remove("is-sidebar-open");
  menuButton?.addEventListener("click", () => document.body.classList.toggle("is-sidebar-open"));
  document.querySelector("[data-sidebar-overlay]")?.addEventListener("click", closeMenu);
  document.querySelectorAll(".handsome-sidebar a").forEach((link) => link.addEventListener("click", closeMenu));
</script>
