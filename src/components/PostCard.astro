---
import type { PostEntry } from "../lib/posts";
import { getPostSlug } from "../lib/posts";

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const slug = getPostSlug(post);
const dateParts = new Intl.DateTimeFormat("zh-CN", {
  year: "numeric",
  month: "2-digit",
  day: "2-digit",
  timeZone: "Asia/Shanghai",
}).formatToParts(post.data.publishedAt);
const datePart = (type: Intl.DateTimeFormatPartTypes) =>
  dateParts.find((part) => part.type === type)?.value ?? "";
const handsomeDate = `${datePart("year")} 年 ${datePart("month")} 月 ${datePart("day")} 日`;
---

<article
  class="post post-card"
  tabindex="0"
  role="link"
  aria-label={`阅读文章：${post.data.title}`}
  data-post-card-href={`/posts/${slug}/`}
>
  <h2 class="post-title">
    <a href={`/posts/${slug}/`}>{post.data.title}</a>
    <svg
      class="post-card-arrow"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <line class="post-card-arrow-line" x1="5" y1="12" x2="19" y2="12"></line>
      <polyline class="post-card-arrow-tip" points="12 5 19 12 12 19"></polyline>
    </svg>
  </h2>
  <ul class="post-meta">
    <li class="post-card-category">
      {
        post.data.category ? (
          <a class="post-card-category-tag" href={`/categories/${post.data.category.slug}/`}>
            <span class="post-card-category-hash">#</span>{post.data.category.name}
          </a>
        ) : (
          <span class="post-card-category-tag">
            <span class="post-card-category-hash">#</span>未分类
          </span>
        )
      }
    </li>
    <li>
      <span class="post-meta-label">时间：</span>
      <time class="post-date-handsome" datetime={post.data.publishedAt.toISOString()}>{handsomeDate}</time>
    </li>
  </ul>
  <div class="post-content">
    <p>{post.data.description}</p>
  </div>
</article>
