<div
	aria-hidden="true"
	class="article-link-preview"
	data-article-link-preview
	data-loaded="false"
	data-open="false"
	id="article-link-preview"
>
	<div class="article-link-preview-shell">
		<div
			aria-live="polite"
			class="article-link-preview-loading"
			data-article-link-preview-loading
			role="status"
		>
			<span aria-hidden="true" class="article-link-preview-spinner"></span>
			<span>正在载入文章预览</span>
		</div>
		<iframe
			data-article-link-preview-frame
			loading="eager"
			name="article-link-preview"
			referrerpolicy="same-origin"
			src="about:blank"
			title="文章预览"
		></iframe>
	</div>
</div>

<style is:global>
	.article-link-preview {
		position: fixed;
		z-index: 100;
		top: 0;
		left: 0;
		width: 42.5rem;
		height: 30rem;
		max-width: calc(100vw - 1.5rem);
		max-height: calc(100vh - 1.5rem);
		box-sizing: border-box;
		visibility: hidden;
		opacity: 0;
		pointer-events: none;
		transform: translateY(4px) scale(0.992);
		transform-origin: top center;
		transition:
			opacity 120ms ease,
			transform 120ms ease,
			visibility 120ms step-end;
	}

	.article-link-preview[data-open="true"] {
		visibility: visible;
		opacity: 1;
		pointer-events: auto;
		transform: translateY(0) scale(1);
		transition:
			opacity 140ms ease,
			transform 140ms ease,
			visibility 0s step-start;
	}

	.article-link-preview-shell {
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
		border: 1px solid color-mix(in srgb, var(--color-muted) 24%, transparent);
		border-radius: 0.8rem;
		background: var(--color-global-bg);
		box-shadow:
			0 22px 60px rgb(15 23 42 / 14%),
			0 5px 18px rgb(15 23 42 / 8%);
	}

	html[data-theme="dark"] .article-link-preview-shell {
		border-color: color-mix(in srgb, var(--color-muted) 34%, transparent);
		box-shadow:
			0 24px 70px rgb(0 0 0 / 42%),
			0 6px 20px rgb(0 0 0 / 28%);
	}

	.article-link-preview iframe {
		display: block;
		width: 100%;
		height: 100%;
		border: 0;
		background: var(--color-global-bg);
	}

	.article-link-preview-loading {
		position: absolute;
		z-index: 1;
		inset: 0;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.65rem;
		background: color-mix(in srgb, var(--color-global-bg) 96%, transparent);
		color: var(--color-muted);
		font-size: 0.75rem;
		letter-spacing: 0.02em;
		transition:
			opacity 140ms ease,
			visibility 140ms step-start;
	}

	.article-link-preview[data-loaded="true"] .article-link-preview-loading {
		visibility: hidden;
		opacity: 0;
		transition:
			opacity 140ms ease,
			visibility 140ms step-end;
	}

	.article-link-preview-spinner {
		width: 0.9rem;
		height: 0.9rem;
		border: 1.5px solid color-mix(in srgb, var(--color-muted) 28%, transparent);
		border-top-color: var(--color-accent);
		border-radius: 999px;
		animation: article-link-preview-spin 650ms linear infinite;
	}

	@keyframes article-link-preview-spin {
		to {
			transform: rotate(1turn);
		}
	}

	html[data-article-preview="true"] {
		scrollbar-gutter: auto;
	}

	html[data-article-preview="true"] body {
		display: block;
		min-height: 0;
		max-width: none;
		margin: 0;
		padding: 0;
	}

	html[data-article-preview="true"] #main {
		width: 100%;
	}

	html[data-article-preview="true"] #main-header,
	html[data-article-preview="true"] body > footer,
	html[data-article-preview="true"] body > a[href="#main"],
	html[data-article-preview="true"] #blog-hero,
	html[data-article-preview="true"] .article-toc,
	html[data-article-preview="true"] [data-preview-hidden],
	html[data-article-preview="true"] [data-article-link-preview],
	html[data-article-preview="true"] #to-top-btn {
		display: none !important;
	}

	html[data-article-preview="true"] [data-article-page] {
		width: 100%;
	}

	html[data-article-preview="true"] [data-article-layout] {
		display: block;
	}

	html[data-article-preview="true"] [data-article-content] {
		width: 100%;
		max-width: none;
		padding: 1.5rem 2rem 4rem;
		box-sizing: border-box;
	}

	@media (hover: none), (pointer: coarse), (max-width: 767px) {
		.article-link-preview {
			display: none !important;
		}
	}
</style>

<script>
	import { computePosition, flip, offset, shift, size } from "@floating-ui/dom";

	const OPEN_DELAY = 200;
	const CLOSE_DELAY = 180;
	const ARTICLE_PREVIEW_NAME = "article-link-preview";
	const ARTICLE_PATH_PREFIX = "posts";

	const articleRoot = document.querySelector<HTMLElement>("[data-article-page]");
	const preview = document.querySelector<HTMLElement>("[data-article-link-preview]");
	const frame = preview?.querySelector<HTMLIFrameElement>("[data-article-link-preview-frame]");

	const isPreviewFrame = window.self !== window.top && window.name === ARTICLE_PREVIEW_NAME;
	const isTouchDevice =
		navigator.maxTouchPoints > 0 ||
		!window.matchMedia("(hover: hover) and (pointer: fine)").matches ||
		window.matchMedia("(max-width: 767px)").matches;

	if (articleRoot && preview && frame && !isPreviewFrame && !isTouchDevice) {
		let activeLink: HTMLAnchorElement | null = null;
		let openTimer: number | undefined;
		let closeTimer: number | undefined;
		let loadToken = 0;

		const clearOpenTimer = () => {
			if (openTimer === undefined) return;
			window.clearTimeout(openTimer);
			openTimer = undefined;
		};

		const clearCloseTimer = () => {
			if (closeTimer === undefined) return;
			window.clearTimeout(closeTimer);
			closeTimer = undefined;
		};

		const isArticlePath = (pathname: string) => {
			const segments = pathname.replace(/\/+$/, "").split("/").filter(Boolean);
			if (segments[0] !== ARTICLE_PATH_PREFIX || segments.length < 2) return false;
			return !(segments.length === 2 && /^\d+$/.test(segments[1] ?? ""));
		};

		const getEligibleLink = (target: EventTarget | null) => {
			if (!(target instanceof Element)) return null;

			const link = target.closest<HTMLAnchorElement>("a[href]");
			if (!link || !articleRoot.contains(link)) return null;
			if (
				link.closest(
					"[data-article-link-preview], [data-preview-hidden], .article-toc, #blog-hero",
				)
			) {
				return null;
			}
			if (link.hasAttribute("download") || link.querySelector("img, picture, svg")) return null;

			const href = link.getAttribute("href")?.trim();
			if (
				!href ||
				href.startsWith("#") ||
				href.startsWith("mailto:") ||
				href.startsWith("tel:") ||
				href.startsWith("javascript:")
			) {
				return null;
			}

			const url = new URL(href, window.location.href);
			if (url.origin !== window.location.origin || url.hash || !isArticlePath(url.pathname)) {
				return null;
			}
			if (url.pathname.replace(/\/+$/, "") === window.location.pathname.replace(/\/+$/, "")) {
				return null;
			}

			return link;
		};

		const setFrameEscapeHandler = () => {
			try {
				frame.contentWindow?.addEventListener("keydown", (event) => {
					if (event.key === "Escape") closePreview();
				});
			} catch {
				// The preview only targets same-origin posts. Ignore navigation away from the site.
			}
		};

		const positionPreview = async (link: HTMLAnchorElement) => {
			const { x, y } = await computePosition(link, preview, {
				middleware: [
					offset(10),
					flip({
						fallbackAxisSideDirection: "end",
						fallbackPlacements: ["top-start", "bottom-end", "top-end"],
						padding: 12,
					}),
					shift({ padding: 12 }),
					size({
						apply({ availableHeight, availableWidth, elements }) {
							Object.assign(elements.floating.style, {
								height: `${Math.max(240, Math.min(480, availableHeight))}px`,
								width: `${Math.max(320, Math.min(680, availableWidth))}px`,
							});
						},
						padding: 12,
					}),
				],
				placement: "bottom-start",
				strategy: "fixed",
			});

			Object.assign(preview.style, {
				left: `${x}px`,
				top: `${y}px`,
			});
		};

		const closePreview = () => {
			clearOpenTimer();
			clearCloseTimer();
			loadToken += 1;

			preview.dataset.open = "false";
			preview.dataset.loaded = "false";
			preview.setAttribute("aria-hidden", "true");
			frame.src = "about:blank";
			frame.title = "文章预览";
			activeLink = null;
		};

		const openPreview = async (link: HTMLAnchorElement) => {
			clearOpenTimer();
			clearCloseTimer();

			const target = new URL(link.href, window.location.href);
			target.searchParams.set("__article_preview", "1");
			target.hash = "";

			const title = link.textContent?.replace(/\s+/g, " ").trim() || "站内文章";
			const token = ++loadToken;
			activeLink = link;
			preview.dataset.loaded = "false";
			preview.setAttribute("aria-hidden", "false");
			frame.title = `文章预览：${title}`;
			frame.src = target.toString();

			await positionPreview(link);
			if (token !== loadToken || activeLink !== link) return;
			preview.dataset.open = "true";
		};

		const scheduleOpen = (link: HTMLAnchorElement) => {
			clearCloseTimer();
			if (activeLink === link && preview.dataset.open === "true") return;

			clearOpenTimer();
			openTimer = window.setTimeout(() => {
				void openPreview(link);
			}, OPEN_DELAY);
		};

		const scheduleClose = () => {
			clearOpenTimer();
			clearCloseTimer();
			closeTimer = window.setTimeout(() => {
				const linkIsActive =
					activeLink?.matches(":hover") || document.activeElement === activeLink;
				const previewIsActive =
					preview.matches(":hover") || preview.contains(document.activeElement);
				if (!linkIsActive && !previewIsActive) closePreview();
			}, CLOSE_DELAY);
		};

		articleRoot.addEventListener("pointerover", (event) => {
			const link = getEligibleLink(event.target);
			if (!link) return;
			if (event.relatedTarget instanceof Node && link.contains(event.relatedTarget)) return;
			scheduleOpen(link);
		});

		articleRoot.addEventListener("pointerout", (event) => {
			const link = getEligibleLink(event.target);
			if (!link) return;
			if (event.relatedTarget instanceof Node && link.contains(event.relatedTarget)) return;
			if (event.relatedTarget instanceof Node && preview.contains(event.relatedTarget)) return;
			scheduleClose();
		});

		articleRoot.addEventListener("focusin", (event) => {
			const link = getEligibleLink(event.target);
			if (link) scheduleOpen(link);
		});

		articleRoot.addEventListener("focusout", (event) => {
			if (!activeLink) return;
			if (event.relatedTarget instanceof Node && preview.contains(event.relatedTarget)) return;
			scheduleClose();
		});

		preview.addEventListener("pointerenter", clearCloseTimer);
		preview.addEventListener("pointerleave", scheduleClose);
		preview.addEventListener("focusin", clearCloseTimer);
		preview.addEventListener("focusout", scheduleClose);

		frame.addEventListener("load", () => {
			if (frame.src === "about:blank" || !activeLink) return;
			preview.dataset.loaded = "true";
			setFrameEscapeHandler();
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") closePreview();
		});

		document.addEventListener("pointerdown", (event) => {
			if (!(event.target instanceof Node)) return;
			if (preview.contains(event.target) || activeLink?.contains(event.target)) return;
			closePreview();
		});

		window.addEventListener("scroll", closePreview, { capture: true, passive: true });
		window.addEventListener("resize", closePreview, { passive: true });
		document.addEventListener("visibilitychange", () => {
			if (document.hidden) closePreview();
		});
	}
</script>
