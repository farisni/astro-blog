---
import type { TocItem } from "@/utils/generateToc";

interface Props {
	heading: TocItem;
}

const {
	heading: { children, depth, slug, text },
} = Astro.props;
---

<li class="article-toc-item">
	<a
		class="article-toc-link"
		data-depth={depth}
		data-toc-link
		href={`#${slug}`}
	>
		<span aria-hidden="true" class="article-toc-marker"></span>
		<span class="article-toc-label">{text}</span>
	</a
	>
	{
		!!children.length && (
			<ol class="article-toc-list">
				{children.map((subheading) => (
					<Astro.self heading={subheading} />
				))}
			</ol>
		)
	}
</li>

<style>
	.article-toc-link[data-depth="3"] .article-toc-marker {
		width: 0.75rem;
	}

	.article-toc-link[data-depth="4"] .article-toc-marker {
		width: 0.5rem;
	}

	.article-toc-link[data-depth="5"] .article-toc-marker,
	.article-toc-link[data-depth="6"] .article-toc-marker {
		width: 0.375rem;
	}
</style>
