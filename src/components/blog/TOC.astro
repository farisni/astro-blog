---
import type { MarkdownHeading } from "astro";
import { generateToc } from "@/utils/generateToc";
import TOCHeading from "./TOCHeading.astro";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const toc = generateToc(headings, {
	maxHeadingLevel: 2,
	minHeadingLevel: 1,
});
---

<aside
	class="article-toc hidden md:block lg:sticky lg:top-[30vh] lg:order-2 lg:-me-40 lg:w-56 lg:shrink-0"
>
	<p class="article-toc-title">目录</p>
	<div class="article-toc-frame">
		<div class="article-toc-scroll">
			<nav aria-label="文章目录">
				<ol class="article-toc-list">
					{toc.map((heading) => <TOCHeading heading={heading} />)}
				</ol>
			</nav>
		</div>
	</div>
</aside>

<style is:global>
	.article-toc {
		max-height: 58vh;
	}

	.article-toc-title {
		margin: 0 0 0.75rem;
		padding-inline: 0.5rem;
		color: var(--color-global-text);
		font-family: var(--font-mono);
		font-size: 0.875rem;
		font-weight: 650;
		line-height: 1.4;
		letter-spacing: 0.08em;
	}

	.article-toc-frame {
		position: relative;
		max-height: calc(58vh - 2rem);
	}

	.article-toc-scroll {
		max-height: calc(58vh - 2rem);
		overflow-y: auto;
		padding: 0.25rem 0.5rem;
		scrollbar-width: none;
	}

	.article-toc-scroll::-webkit-scrollbar {
		display: none;
	}

	.article-toc-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.article-toc-list .article-toc-list {
		margin-top: 0.25rem;
	}

	.article-toc-item + .article-toc-item {
		margin-top: 0.375rem;
	}

	.article-toc-list .article-toc-list > .article-toc-item + .article-toc-item {
		margin-top: 0.1875rem;
	}

	.article-toc-link {
		display: grid;
		grid-template-columns: 1.125rem minmax(0, 1fr);
		align-items: center;
		gap: 0.625rem;
		color: color-mix(in srgb, var(--color-muted) 68%, var(--color-global-bg));
		font-size: 0.8125rem;
		font-weight: 400;
		line-height: 1.45;
		text-decoration: none;
		transition: color 180ms ease;
	}

	.article-toc-link[data-depth="1"] {
		color: color-mix(in srgb, var(--color-muted) 88%, var(--color-global-bg));
		font-weight: 500;
	}

	.article-toc-marker {
		width: 1rem;
		height: 0.1875rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--color-muted) 15%, var(--color-global-bg));
		transition:
			width 180ms ease,
			background-color 180ms ease;
	}

	.article-toc-link[data-depth="2"] .article-toc-label {
		padding-inline-start: 1rem;
	}

	.article-toc-label.has-leading-emoji {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: start;
		column-gap: 0.45em;
	}

	.article-toc-text {
		min-width: 0;
	}

	.article-toc-link:hover {
		color: var(--color-global-text);
	}

	.article-toc-link.is-active {
		color: color-mix(in srgb, var(--color-accent) 80%, white);
		font-weight: 500;
	}

	.article-toc-link.is-active .article-toc-marker {
		background: color-mix(in srgb, var(--color-accent) 80%, white);
	}

	@media (max-width: 1023px) {
		.article-toc,
		.article-toc-frame,
		.article-toc-scroll {
			max-height: none;
		}

		.article-toc-scroll {
			padding: 0.5rem 0;
		}
	}
</style>

<script>
	const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
	const tocHeadings = tocLinks
		.map((link) => {
			const id = decodeURIComponent(link.hash.slice(1));
			const heading = document.getElementById(id);
			return heading ? { heading, link } : null;
		})
		.filter((item): item is { heading: HTMLElement; link: HTMLAnchorElement } => item !== null);

	const updateActiveTocItem = () => {
		const activationLine = window.innerHeight * 0.32;
		let active = tocHeadings[0];

		for (const item of tocHeadings) {
			if (item.heading.getBoundingClientRect().top <= activationLine) active = item;
			else break;
		}

		for (const item of tocHeadings) {
			const isActive = item === active;
			item.link.classList.toggle("is-active", isActive);
			if (isActive) item.link.setAttribute("aria-current", "location");
			else item.link.removeAttribute("aria-current");
		}
	};

	updateActiveTocItem();
	document.addEventListener("scroll", updateActiveTocItem, { passive: true });
</script>
