---
import type { MarkdownHeading } from "astro";
import { generateToc } from "@/utils/generateToc";
import TOCHeading from "./TOCHeading.astro";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const toc = generateToc(headings, {
	maxHeadingLevel: 2,
	minHeadingLevel: 1,
});
---

<aside
	class="article-toc hidden md:block lg:sticky lg:top-[30vh] lg:order-2 lg:-me-40 lg:w-56 lg:shrink-0"
>
	<div class="article-toc-frame" data-toc-frame>
		<div class="article-toc-scroll" data-toc-scroll>
			<nav aria-label="文章目录">
				<ol class="article-toc-list">
					{toc.map((heading) => <TOCHeading heading={heading} />)}
				</ol>
			</nav>
		</div>
		<span aria-hidden="true" class="article-toc-fade article-toc-fade-top"></span>
		<span aria-hidden="true" class="article-toc-fade article-toc-fade-bottom"></span>
	</div>
</aside>

<style is:global>
	.article-toc {
		max-height: 58vh;
	}

	.article-toc-frame {
		position: relative;
		max-height: 58vh;
	}

	.article-toc-scroll {
		max-height: 58vh;
		overflow-y: auto;
		padding: 0.25rem 0.5rem;
		scrollbar-width: none;
	}

	.article-toc-scroll::-webkit-scrollbar {
		display: none;
	}

	.article-toc-fade {
		position: absolute;
		z-index: 2;
		inset-inline: 0;
		height: 1.75rem;
		pointer-events: none;
		opacity: 0;
		transition: opacity 180ms ease;
		backdrop-filter: blur(2px);
	}

	.article-toc-fade-top {
		top: 0;
		background: linear-gradient(
			to bottom,
			color-mix(in srgb, var(--color-global-bg) 94%, transparent),
			transparent
		);
		-webkit-mask-image: linear-gradient(to bottom, #000 20%, transparent);
		mask-image: linear-gradient(to bottom, #000 20%, transparent);
	}

	.article-toc-fade-bottom {
		bottom: 0;
		background: linear-gradient(
			to top,
			color-mix(in srgb, var(--color-global-bg) 94%, transparent),
			transparent
		);
		-webkit-mask-image: linear-gradient(to top, #000 20%, transparent);
		mask-image: linear-gradient(to top, #000 20%, transparent);
	}

	.article-toc-frame[data-fade-top="true"] .article-toc-fade-top,
	.article-toc-frame[data-fade-bottom="true"] .article-toc-fade-bottom {
		opacity: 1;
	}

	.article-toc-list {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.article-toc-list .article-toc-list {
		margin-top: 0.25rem;
	}

	.article-toc-item + .article-toc-item {
		margin-top: 0.375rem;
	}

	.article-toc-list .article-toc-list > .article-toc-item + .article-toc-item {
		margin-top: 0.1875rem;
	}

	.article-toc-link {
		display: grid;
		grid-template-columns: 1.125rem minmax(0, 1fr);
		align-items: center;
		gap: 0.625rem;
		color: color-mix(in srgb, var(--color-muted) 68%, var(--color-global-bg));
		font-size: 0.8125rem;
		font-weight: 400;
		line-height: 1.45;
		text-decoration: none;
		transition: color 180ms ease;
	}

	.article-toc-link[data-depth="1"] {
		color: color-mix(in srgb, var(--color-muted) 88%, var(--color-global-bg));
		font-weight: 500;
	}

	.article-toc-marker {
		width: 1rem;
		height: 0.1875rem;
		border-radius: 999px;
		background: color-mix(in srgb, var(--color-muted) 15%, var(--color-global-bg));
		transition:
			width 180ms ease,
			background-color 180ms ease;
	}

	.article-toc-link[data-depth="2"] .article-toc-label {
		padding-inline-start: 1rem;
	}

	.article-toc-link:hover {
		color: var(--color-global-text);
	}

	.article-toc-link.is-active {
		color: color-mix(in srgb, var(--color-accent) 80%, white);
		font-weight: 500;
	}

	.article-toc-link.is-active .article-toc-marker {
		background: color-mix(in srgb, var(--color-accent) 80%, white);
	}

	@media (max-width: 1023px) {
		.article-toc,
		.article-toc-frame,
		.article-toc-scroll {
			max-height: none;
		}

		.article-toc-scroll {
			padding: 0.5rem 0;
		}

		.article-toc-fade {
			display: none;
		}
	}
</style>

<script>
	const tocFrame = document.querySelector<HTMLElement>("[data-toc-frame]");
	const tocScroll = tocFrame?.querySelector<HTMLElement>("[data-toc-scroll]");

	const updateTocFades = () => {
		if (!tocFrame || !tocScroll) return;

		const hasOverflow = tocScroll.scrollHeight > tocScroll.clientHeight + 1;
		const canScrollUp = hasOverflow && tocScroll.scrollTop > 2;
		const canScrollDown =
			hasOverflow &&
			tocScroll.scrollTop + tocScroll.clientHeight < tocScroll.scrollHeight - 2;

		tocFrame.dataset.fadeTop = canScrollUp.toString();
		tocFrame.dataset.fadeBottom = canScrollDown.toString();
	};

	tocScroll?.addEventListener("scroll", updateTocFades, { passive: true });
	if (tocScroll) {
		new ResizeObserver(updateTocFades).observe(tocScroll);
		updateTocFades();
	}

	const tocLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]"));
	const tocHeadings = tocLinks
		.map((link) => {
			const id = decodeURIComponent(link.hash.slice(1));
			const heading = document.getElementById(id);
			return heading ? { heading, link } : null;
		})
		.filter((item): item is { heading: HTMLElement; link: HTMLAnchorElement } => item !== null);

	const updateActiveTocItem = () => {
		const activationLine = window.innerHeight * 0.32;
		let active = tocHeadings[0];

		for (const item of tocHeadings) {
			if (item.heading.getBoundingClientRect().top <= activationLine) active = item;
			else break;
		}

		for (const item of tocHeadings) {
			const isActive = item === active;
			item.link.classList.toggle("is-active", isActive);
			if (isActive) item.link.setAttribute("aria-current", "location");
			else item.link.removeAttribute("aria-current");
		}
	};

	updateActiveTocItem();
	document.addEventListener("scroll", updateActiveTocItem, { passive: true });
</script>
