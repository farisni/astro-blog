---
import type { CollectionEntry } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "@/components/FormattedDate.astro";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"post">;
	withDesc?: boolean;
};

const { as: Tag = "div", post, withDesc = false } = Astro.props;
---

<FormattedDate
	class="text-muted min-w-28 text-xs font-medium tracking-wide tabular-nums opacity-85"
	date={post.data.publishDate}
/>
<Tag class="post-title-group">
	{
		post.data.draft && (
			<span class="bg-accent/10 text-accent me-2 inline-flex rounded px-1.5 py-0.5 text-xs font-normal">
				草稿
			</span>
		)
	}
	<a class="cactus-link" href={`/posts/${post.id}/`}>
		{post.data.title}
	</a>
</Tag>
{withDesc && <q class="line-clamp-3 italic">{post.data.description}</q>}

<style>
	.post-title-group {
		position: relative;
		z-index: 0;
		display: inline-flex;
		width: fit-content;
		align-items: baseline;
		isolation: isolate;
	}

	.post-title-group .cactus-link {
		font-weight: 450;
		text-decoration: none;
		transition: color 150ms cubic-bezier(0.4, 0, 0.2, 1);
	}

	.post-title-group::before {
		position: absolute;
		z-index: -1;
		inset: -0.2rem -0.55rem;
		border-radius: 0.375rem;
		background: #f2f4f7;
		content: "";
		opacity: 0;
		transform: scale(0.85);
		transition:
			opacity 150ms cubic-bezier(0.4, 0, 0.2, 1),
			transform 150ms cubic-bezier(0.4, 0, 0.2, 1);
	}

	.post-title-group:hover::before {
		opacity: 1;
		transform: scale(1);
	}

	:global(html[data-theme="dark"]) .post-title-group::before {
		background: #1e293b;
	}

	.post-title-group:hover .cactus-link {
		color: var(--color-accent);
	}
</style>
