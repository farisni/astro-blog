---
import type { CollectionEntry } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "@/components/FormattedDate.astro";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"post">;
	withDesc?: boolean;
};

const { as: Tag = "div", post, withDesc = false } = Astro.props;
---

<FormattedDate
	class="text-muted min-w-28 text-xs font-medium tracking-wide tabular-nums opacity-85"
	date={post.data.publishDate}
/>
<Tag class="post-title-group">
	{
		post.data.draft && (
			<span class="bg-accent/10 text-accent me-2 inline-flex rounded px-1.5 py-0.5 text-xs font-normal">
				草稿
			</span>
		)
	}
	<a class="cactus-link" href={`/posts/${post.id}/`}>
		{post.data.title}
	</a>
</Tag>
{withDesc && <q class="line-clamp-3 italic">{post.data.description}</q>}
