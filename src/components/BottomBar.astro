---
import { themeConfig } from '@/config'
import { ui } from '@/i18n/ui'
import { getPageInfo } from '@/utils/page'

const {
  currentLang,
  isHome,
  isPost,
  isTag,
  isAbout,
  getLocalizedPath,
} = getPageInfo(Astro.url.pathname)
const currentUI = ui[currentLang as keyof typeof ui] ?? {}
const { title, i18nTitle } = themeConfig.site
const siteTitle = i18nTitle ? currentUI.title : title
const githubUrl = themeConfig.footer.links.find(({ name }) => name.toLowerCase() === 'github')?.url
const emailAddress = themeConfig.footer.links.find(({ name }) => name.toLowerCase() === 'email')?.url
const lightMode = themeConfig.color.light.background
const darkMode = themeConfig.color.dark.background

function getNavItemClass(isActive: boolean) {
  return isActive
    ? 'c-primary font-bold'
    : 'c-secondary transition-colors hover:c-primary'
}

function getNavLabelClass(isActive: boolean) {
  return isActive
    ? 'bottom-bar-nav-label underline'
    : 'bottom-bar-nav-label hover:underline'
}

const navItems = [
  {
    href: '/',
    label: currentUI.posts,
    active: isHome || isPost,
  },
  {
    href: '/tags/',
    label: currentUI.tags,
    active: isTag,
  },
  {
    href: '/about/',
    label: currentUI.about,
    active: isAbout,
  },
]
---

<div id="bottom-bar-shell">
  <div
    id="bottom-bar-mobile-menu"
    class="absolute bottom-[calc(100%+0.75rem)] right-4 hidden min-w-34 flex-col border border-secondary/15 bg-background/95 p-2 shadow-xl backdrop-blur-xl lg:hidden"
    aria-label="Mobile site navigation"
  >
    {navItems.map(item => (
      <a
        href={getLocalizedPath(item.href)}
        class:list={[
          'px-4 py-2.5 text-4 font-navbar cjk:tracking-wide',
          item.active ? 'c-primary font-bold' : 'c-secondary hover:c-primary',
        ]}
      >
        <span class={getNavLabelClass(item.active)}>{item.label}</span>
      </a>
    ))}
  </div>

  <div class="border-t border-secondary/12 bg-background/92 shadow-[0_-0.5rem_2rem_oklch(0%_0_0/0.06)] backdrop-blur-xl">
    <div class="mx-auto flex h-15 max-w-360 items-center justify-between px-[min(5vw,3.5rem)] lg:h-14">
      <div class="min-w-0 flex items-center">
        <a
          href={getLocalizedPath('/')}
          class="truncate text-4.5 c-primary font-bold font-title transition-colors hover:c-secondary lg:text-5"
        >
          {siteTitle}
        </a>

        <nav
          class="ml-9 hidden items-center gap-7 text-4 font-navbar cjk:tracking-wide lg:flex"
          aria-label="Bottom site navigation"
        >
          {navItems.map(item => (
            <a
              href={getLocalizedPath(item.href)}
              class={getNavItemClass(item.active)}
            >
              <span class={getNavLabelClass(item.active)}>{item.label}</span>
            </a>
          ))}
        </nav>
      </div>

      <div class="shrink-0 flex items-center gap-2">
        <div class="shrink-0 flex items-center gap-1.5">
          <button
            id="theme-toggle-button"
            class="grid h-8 w-7 place-items-center c-secondary transition-colors active:scale-90 hover:c-primary"
            type="button"
            data-light-mode={lightMode}
            data-dark-mode={darkMode}
            aria-label="切换深浅模式"
            title="切换深浅模式"
          >
            <svg
              class="bottom-bar-theme-icon h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <g class="bottom-bar-theme-sun">
                <circle cx="12" cy="12" r="3.5"/>
                <path d="M12 2.5v2M12 19.5v2M4.5 12h-2M21.5 12h-2M5.28 5.28l1.42 1.42M17.3 17.3l1.42 1.42M18.72 5.28 17.3 6.7M6.7 17.3l-1.42 1.42"/>
              </g>
              <path
                class="bottom-bar-theme-moon"
                d="M20.2 14.2A8.4 8.4 0 0 1 9.8 3.8 8.5 8.5 0 1 0 20.2 14.2Z"
              />
            </svg>
          </button>

          {githubUrl && (
            <a
              href={githubUrl}
              class="grid h-8 w-7 place-items-center c-secondary transition-colors hover:c-primary"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              title="GitHub"
              data-umami-event="outbound-link-click"
              data-umami-event-url={githubUrl}
            >
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.02c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.71.08-.71 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.38.97.1-.75.4-1.27.74-1.56-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18a10.95 10.95 0 0 1 5.75 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.42-2.71 5.39-5.29 5.68.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/>
              </svg>
            </a>
          )}

          {emailAddress && (
            <a
              href={`mailto:${emailAddress}`}
              class="grid h-8 w-7 place-items-center c-secondary transition-colors hover:c-primary"
              aria-label="Email"
              title="Email"
              data-umami-event="outbound-link-click"
              data-umami-event-url={`mailto:${emailAddress}`}
            >
              <svg class="h-5.5 w-5.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="1.5"/>
                <path d="m4 7 8 6 8-6"/>
              </svg>
            </a>
          )}
        </div>

        <button
          id="bottom-bar-menu-button"
          class="grid aspect-square w-9 place-items-center c-secondary transition-colors hover:c-primary lg:hidden"
          type="button"
          aria-label="打开菜单"
          aria-controls="bottom-bar-mobile-menu"
          aria-expanded="false"
        >
          <span class="bottom-bar-menu-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  #bottom-bar-shell {
    --bottom-bar-underline: #ffea00;

    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 1000;
    padding-bottom: env(safe-area-inset-bottom);
    transform: translateY(0);
    transition: transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(html.dark) #bottom-bar-shell {
    --bottom-bar-underline: #ffea00;
  }

  .bottom-bar-nav-label {
    text-decoration-color: var(--bottom-bar-underline);
    text-decoration-thickness: 0.12em;
    text-underline-offset: 0.06em;
  }

  .bottom-bar-theme-sun,
  .bottom-bar-theme-moon {
    transform-origin: center;
    transition: opacity 180ms ease, transform 180ms ease;
  }

  .bottom-bar-theme-moon {
    opacity: 0;
    transform: scale(0.7) rotate(-20deg);
  }

  :global(html.dark) .bottom-bar-theme-sun {
    opacity: 0;
    transform: scale(0.7) rotate(20deg);
  }

  :global(html.dark) .bottom-bar-theme-moon {
    opacity: 1;
    transform: scale(1) rotate(0);
  }

  #bottom-bar-shell[data-hidden] {
    transform: translateY(calc(100% + env(safe-area-inset-bottom)));
  }

  #bottom-bar-mobile-menu[data-open] {
    display: flex;
    animation: bottom-bar-menu-in 180ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .bottom-bar-menu-icon {
    position: relative;
    display: grid;
    width: 1.15rem;
    gap: 0.22rem;
  }

  .bottom-bar-menu-icon span {
    display: block;
    height: 1px;
    width: 100%;
    background: currentColor;
    transition: transform 180ms ease, opacity 180ms ease;
  }

  #bottom-bar-menu-button[aria-expanded='true'] .bottom-bar-menu-icon span:nth-child(1) {
    transform: translateY(0.28rem) rotate(45deg);
  }

  #bottom-bar-menu-button[aria-expanded='true'] .bottom-bar-menu-icon span:nth-child(2) {
    opacity: 0;
  }

  #bottom-bar-menu-button[aria-expanded='true'] .bottom-bar-menu-icon span:nth-child(3) {
    transform: translateY(-0.28rem) rotate(-45deg);
  }

  @keyframes bottom-bar-menu-in {
    from {
      opacity: 0;
      transform: translateY(0.5rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media print {
    #bottom-bar-shell {
      display: none;
    }
  }
</style>

<script>
interface BottomBarWindow extends Window {
  __bottomBarCleanup?: () => void
  __bottomBarPageLoadBound?: boolean
}

function setupBottomBar() {
  const appWindow = window as BottomBarWindow
  appWindow.__bottomBarCleanup?.()

  const shell = document.getElementById('bottom-bar-shell')
  const menu = document.getElementById('bottom-bar-mobile-menu')
  const button = document.getElementById('bottom-bar-menu-button')
  const themeButton = document.getElementById('theme-toggle-button')

  if (
    !shell
    || !menu
    || !(button instanceof HTMLButtonElement)
    || !(themeButton instanceof HTMLButtonElement)
  ) {
    return
  }

  const bottomBarShell = shell
  const mobileMenu = menu
  const menuButton = button
  const themeToggleButton = themeButton
  const colorSchemeQuery = window.matchMedia('(prefers-color-scheme: dark)')
  let lastScrollY = window.scrollY
  let menuOpen = false

  function applyTheme(isDark: boolean) {
    document.documentElement.classList.toggle('dark', isDark)

    const metaThemeColor = document.head.querySelector('meta[name="theme-color"]')
    const selectedMode = isDark
      ? themeToggleButton.dataset.darkMode
      : themeToggleButton.dataset.lightMode

    if (metaThemeColor && selectedMode) {
      metaThemeColor.setAttribute('content', selectedMode)
    }

    localStorage.setItem('theme', isDark ? 'dark' : 'light')
    document.dispatchEvent(new Event('theme-changed'))
  }

  function toggleTheme() {
    applyTheme(!document.documentElement.classList.contains('dark'))
  }

  function handleThemeToggle() {
    if (
      document.documentElement.classList.contains('reduce-motion')
      || !document.startViewTransition
    ) {
      toggleTheme()
      return
    }

    document.documentElement.style.setProperty('view-transition-name', 'theme-toggle-transition')
    document.documentElement.setAttribute('data-theme-changing', '')

    const transition = document.startViewTransition(toggleTheme)
    transition.finished.then(() => {
      document.documentElement.style.removeProperty('view-transition-name')
      document.documentElement.removeAttribute('data-theme-changing')
    })
  }

  function handleSystemChange(event: MediaQueryListEvent) {
    applyTheme(event.matches)
  }

  function setMenuOpen(open: boolean) {
    menuOpen = open
    menuButton.setAttribute('aria-expanded', String(open))
    menuButton.setAttribute('aria-label', open ? '关闭菜单' : '打开菜单')
    mobileMenu.toggleAttribute('data-open', open)
    bottomBarShell.toggleAttribute('data-hidden', false)
  }

  function handleScroll() {
    const currentScrollY = Math.max(window.scrollY, 0)

    if (menuOpen || currentScrollY <= 16) {
      bottomBarShell.toggleAttribute('data-hidden', false)
    }
    else if (currentScrollY > lastScrollY + 2) {
      setMenuOpen(false)
      bottomBarShell.toggleAttribute('data-hidden', true)
    }
    else if (currentScrollY < lastScrollY - 2) {
      bottomBarShell.toggleAttribute('data-hidden', false)
    }

    lastScrollY = currentScrollY
  }

  function handleButtonClick(event: MouseEvent) {
    event.stopPropagation()
    setMenuOpen(!menuOpen)
  }

  function handleDocumentClick(event: MouseEvent) {
    if (!(event.target instanceof Node)) {
      return
    }

    if (menuOpen && !mobileMenu.contains(event.target) && !menuButton.contains(event.target)) {
      setMenuOpen(false)
    }
  }

  function handleKeydown(event: KeyboardEvent) {
    if (event.key === 'Escape' && menuOpen) {
      setMenuOpen(false)
      menuButton.focus()
    }
  }

  menuButton.addEventListener('click', handleButtonClick)
  themeToggleButton.addEventListener('click', handleThemeToggle)
  colorSchemeQuery.addEventListener('change', handleSystemChange)
  window.addEventListener('scroll', handleScroll, { passive: true })
  document.addEventListener('click', handleDocumentClick)
  document.addEventListener('keydown', handleKeydown)

  appWindow.__bottomBarCleanup = () => {
    menuButton.removeEventListener('click', handleButtonClick)
    themeToggleButton.removeEventListener('click', handleThemeToggle)
    colorSchemeQuery.removeEventListener('change', handleSystemChange)
    window.removeEventListener('scroll', handleScroll)
    document.removeEventListener('click', handleDocumentClick)
    document.removeEventListener('keydown', handleKeydown)
  }
}

const appWindow = window as BottomBarWindow
if (!appWindow.__bottomBarPageLoadBound) {
  document.addEventListener('astro:page-load', setupBottomBar)
  appWindow.__bottomBarPageLoadBound = true
}
setupBottomBar()
</script>
