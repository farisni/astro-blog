---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts, getTags } from "../../lib/posts";

const tags = getTags(await getPublishedPosts());
---

<BaseLayout title="文章标签">
  <header class="lite-category-header"><span>TOPICS</span><h1>文章标签</h1><p>从关键词进入感兴趣的内容。</p></header>
  <div class="tag-cloud">
    {tags.map((tag) => <a href={`/tags/${tag.slug}/`}>#{tag.name}<small>{tag.count}</small></a>)}
  </div>
</BaseLayout>
