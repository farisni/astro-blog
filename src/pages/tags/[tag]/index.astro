---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PostList from "../../../components/PostList.astro";
import Pagination from "../../../components/Pagination.astro";
import { siteConfig } from "../../../config";
import { getPublishedPosts, getTags, type PostEntry } from "../../../lib/posts";

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return getTags(posts).map((tag) => {
    const filtered = posts.filter((post) => post.data.tags.some((item) => item.slug === tag.slug));
    return {
      params: { tag: tag.slug },
      props: { tag, posts: filtered.slice(0, siteConfig.postsPerPage), totalPages: Math.ceil(filtered.length / siteConfig.postsPerPage) },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  tag: { name: string; slug: string; count: number };
  posts: PostEntry[];
  totalPages: number;
}

const { tag, posts, totalPages } = Astro.props;
---

<BaseLayout title={`标签：${tag.name}`}>
  <header class="lite-category-header"><span>TAG</span><h1>标签 <strong>#{tag.name}</strong></h1><p>共收录 {tag.count} 篇文章</p></header>
  <PostList posts={posts} />
  <Pagination currentPage={1} totalPages={totalPages} baseUrl={`/tags/${tag.slug}/`} />
</BaseLayout>
