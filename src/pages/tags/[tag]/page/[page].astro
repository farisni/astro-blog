---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import PostList from "../../../../components/PostList.astro";
import Pagination from "../../../../components/Pagination.astro";
import { siteConfig } from "../../../../config";
import { getPublishedPosts, getTags, type PostEntry } from "../../../../lib/posts";

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return getTags(posts).flatMap((tag) => {
    const filtered = posts.filter((post) => post.data.tags.some((item) => item.slug === tag.slug));
    const totalPages = Math.ceil(filtered.length / siteConfig.postsPerPage);
    return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
      const page = index + 2;
      const start = (page - 1) * siteConfig.postsPerPage;
      return {
        params: { tag: tag.slug, page: String(page) },
        props: { tag, page, totalPages, posts: filtered.slice(start, start + siteConfig.postsPerPage) },
      };
    });
  });
}) satisfies GetStaticPaths;

interface Props {
  tag: { name: string; slug: string };
  page: number;
  totalPages: number;
  posts: PostEntry[];
}

const { tag, page, totalPages, posts } = Astro.props;
---

<BaseLayout title={`标签：${tag.name} · 第 ${page} 页`}>
  <header class="lite-category-header"><span>TAG</span><h1>#{tag.name}</h1><p>第 {page} 页</p></header>
  <PostList posts={posts} />
  <Pagination currentPage={page} totalPages={totalPages} baseUrl={`/tags/${tag.slug}/`} />
</BaseLayout>
