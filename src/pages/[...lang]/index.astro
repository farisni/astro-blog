---
import TimelinePostList from '@/components/TimelinePostList.astro'
import { allLocales } from '@/config'
import type { Language } from '@/i18n/config'
import { getLangFromLocale, getLangRouteParam } from '@/i18n/lang'
import { ui } from '@/i18n/ui'
import Layout from '@/layouts/Layout.astro'
import type { Post } from '@/types'
import { getPinnedPosts, getPostsByYear } from '@/utils/content'

export async function getStaticPaths() {
  return allLocales.map(lang => ({
    params: { lang: getLangRouteParam(lang) },
  }))
}

const currentLang = getLangFromLocale(Astro.currentLocale)
const pinnedPosts = await getPinnedPosts(currentLang)
const postsByYear = await getPostsByYear(currentLang)

function groupPostsByYear(posts: Post[]) {
  const groups = new Map<number, Post[]>()

  posts.forEach((post) => {
    const year = post.data.publishDate.getFullYear()
    const yearPosts = groups.get(year) ?? []
    yearPosts.push(post)
    groups.set(year, yearPosts)
  })

  return groups
}

const recentPostsByYear = groupPostsByYear(pinnedPosts)
const pinnedLabels: Record<Language, string> = {
  de: 'Angeheftet',
  en: 'Pinned',
  es: 'Destacados',
  fr: 'Épinglés',
  ja: '固定',
  ko: '고정',
  pl: 'Przypięte',
  pt: 'Fixados',
  ru: 'Закреплённые',
  zh: '置顶',
  'zh-tw': '置頂',
}
---

<Layout>
  <!-- Pinned Posts -->
  {pinnedPosts.length > 0 && (
    <section class="mb-7">
      <header class="mb-3.5">
        <h2 class="text-5.5 c-primary font-navbar font-bold leading-[1.4] tracking-wide">
          <span class="section-heading-highlight highlight-static">
            {pinnedLabels[currentLang]}
          </span>
        </h2>
      </header>
      {Array.from(recentPostsByYear.entries(), ([year, posts]) => (
        <TimelinePostList
          posts={posts}
          lang={currentLang}
          year={year}
        />
      ))}
    </section>
  )}

  <!-- Regular Posts -->
  {postsByYear.size > 0 && (
    <section class="mb-7">
      <header class="mb-3.5">
        <h2 class="text-5.5 c-primary font-navbar font-bold leading-[1.4] tracking-wide">
          <span class="section-heading-highlight highlight-static">
            {ui[currentLang].posts}
          </span>
        </h2>
      </header>
      {Array.from(postsByYear.entries(), ([year, posts]) => (
        <TimelinePostList
          posts={posts}
          lang={currentLang}
          year={year}
        />
      ))}
    </section>
  )}
</Layout>

<style>
  .section-heading-highlight::after {
    bottom: 0.42em;
    height: 0.34em;
  }
</style>
