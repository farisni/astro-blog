---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostList from "../../components/PostList.astro";
import Pagination from "../../components/Pagination.astro";
import { siteConfig } from "../../config";
import { getPublishedPosts, type PostEntry } from "../../lib/posts";

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  const totalPages = Math.ceil(posts.length / siteConfig.postsPerPage);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const page = index + 2;
    const start = (page - 1) * siteConfig.postsPerPage;
    return {
      params: { page: String(page) },
      props: { page, totalPages, posts: posts.slice(start, start + siteConfig.postsPerPage) },
    };
  });
}) satisfies GetStaticPaths;

interface Props {
  page: number;
  totalPages: number;
  posts: PostEntry[];
}

const { page, totalPages, posts } = Astro.props;
---

<BaseLayout title={`第 ${page} 页`}>
  <PostList posts={posts} />
  <Pagination currentPage={page} totalPages={totalPages} baseUrl="/" />
</BaseLayout>
