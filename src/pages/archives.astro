---
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatDate } from "../lib/format";
import { getArchives, getPostSlug, getPublishedPosts } from "../lib/posts";

const posts = await getPublishedPosts();
const archives = getArchives(posts);
---

<BaseLayout title="文章归档">
  <header class="lite-category-header"><span>TIMELINE</span><h1>文章归档</h1><p>共写下 {posts.length} 篇文章。</p></header>
  <div class="archive-list">
    {archives.map((archive) => (
      <section id={archive.key}>
        <h2>{archive.label}<small>{archive.count}</small></h2>
        <ol>
          {posts.filter((post) => {
            const date = post.data.publishedAt;
            return archive.key === `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}`;
          }).map((post) => (
            <li><time>{formatDate(post.data.publishedAt)}</time><a href={`/posts/${getPostSlug(post)}/`}>{post.data.title}</a></li>
          ))}
        </ol>
      </section>
    ))}
  </div>
</BaseLayout>
